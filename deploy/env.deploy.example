# Copy to .env.deploy at the project root; never commit real values.
SITE_ADDRESS=campus.example.edu
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=campus.example.edu,localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=https://campus.example.edu
FRONTEND_URL=https://campus.example.edu
POSTGRES_DB=smartcampus
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=replace-with-a-long-random-password
VISION_API_KEY=replace-with-an-independent-long-random-key
VISION_PERSON_CLASSES=person
VISION_SEAT_CLASSES=tv
VISION_SEAT_SEMANTICS=monitors
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.edu
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-secret
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Smart Campus Vision <no-reply@example.edu>
